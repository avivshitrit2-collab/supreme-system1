<html dir="rtl" lang="he">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>אלפון ספקים עסקי</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f5f5f5;direction:rtl}
.header{background:#1a3a5c;color:white;padding:16px 24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px}
.header h1{font-size:20px;font-weight:600}
.header .subtitle{font-size:13px;opacity:0.8}
.stats{display:flex;gap:10px;background:#e8f0f8;padding:10px 24px;flex-wrap:wrap}
.stat{background:white;border-radius:8px;padding:8px 16px;text-align:center;min-width:100px;border:1px solid #d0dcea}
.stat-num{font-size:22px;font-weight:700;color:#1a3a5c}
.stat-label{font-size:11px;color:#666;margin-top:2px}
.stat.active .stat-num{color:#16a34a}
.stat.inactive .stat-num{color:#dc2626}
.stat.blocked .stat-num{color:#d97706}
.toolbar{padding:12px 24px;background:white;border-bottom:1px solid #ddd;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.toolbar input,.toolbar select{padding:7px 10px;border:1px solid #ccc;border-radius:6px;font-size:13px;font-family:Arial}
#searchBox{flex:1;min-width:200px}
.btn{padding:7px 14px;border:none;border-radius:6px;cursor:pointer;font-size:13px;font-weight:600}
.btn-primary{background:#1a3a5c;color:white}
.btn-primary:hover{background:#234d7a}
.btn-success{background:#16a34a;color:white}
.btn-danger{background:#dc2626;color:white;font-size:11px;padding:4px 8px}
.btn-edit{background:#f0f4ff;color:#1a3a5c;border:1px solid #c0d0ea;font-size:11px;padding:4px 8px}
.table-container{overflow:auto;max-height:calc(100vh - 260px)}
table{width:100%;border-collapse:collapse;font-size:13px;min-width:700px}
thead th{background:#1a3a5c;color:white;padding:9px 10px;text-align:right;font-weight:600;position:sticky;top:0;z-index:5;cursor:pointer;white-space:nowrap;user-select:none}
thead th:hover{background:#234d7a}
tbody tr:nth-child(even){background:#f9fbff}
tbody tr:hover{background:#e8f0f8}
td{padding:7px 10px;border-bottom:1px solid #eee;vertical-align:middle}
.badge{display:inline-block;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600}
.badge-פעיל{background:#dcfce7;color:#15803d;border:1px solid #bbf7d0}
.badge-לא.פעיל{background:#fee2e2;color:#b91c1c;border:1px solid #fecaca}
.badge-חדש{background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd}
.badge-חסום{background:#fef3c7;color:#92400e;border:1px solid #fde68a}
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:100;align-items:center;justify-content:center}
.modal-bg.open{display:flex}
.modal{background:white;border-radius:12px;padding:24px;width:480px;max-width:95vw;max-height:90vh;overflow-y:auto}
.modal h2{font-size:17px;margin-bottom:16px;color:#1a3a5c}
.form-row{margin-bottom:12px}
.form-row label{display:block;font-size:12px;color:#555;margin-bottom:4px;font-weight:600}
.form-row input,.form-row select,.form-row textarea{width:100%;padding:8px 10px;border:1px solid #ccc;border-radius:6px;font-size:13px;font-family:Arial}
.form-row textarea{height:60px;resize:vertical}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.modal-footer{display:flex;gap:8px;margin-top:16px;justify-content:flex-start}
.empty{text-align:center;padding:48px;color:#888}
.page-info{padding:8px 24px;font-size:12px;color:#666;background:white;border-top:1px solid #eee;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}
.page-controls{display:flex;gap:4px;align-items:center}
.page-btn{padding:4px 10px;border:1px solid #ccc;border-radius:4px;cursor:pointer;background:white;font-size:12px}
.page-btn.active{background:#1a3a5c;color:white;border-color:#1a3a5c}
.page-btn:hover:not(.active){background:#f0f4ff}
.sync-bar{background:#fff3cd;border-bottom:1px solid #ffc107;padding:6px 24px;font-size:12px;color:#856404;display:none}
.sync-bar.show{display:flex;align-items:center;justify-content:space-between}
#loadingBar{background:#1a3a5c;color:white;padding:8px 24px;font-size:13px;display:flex;align-items:center;gap:10px}
.spinner{width:16px;height:16px;border:2px solid rgba(255,255,255,0.3);border-top-color:white;border-radius:50%;animation:spin 0.8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
</style>
</head>
<body>
<div id="loadingBar">
  <div class="spinner"></div>
  <span id="loadingMsg">טוען נתונים...</span>
</div>

<div id="app" style="display:none">
<div class="header">
  <div>
    <div class="header h1">📋 אלפון ספקים עסקי</div>
    <div class="subtitle">מערכת ניהול ספקים משותפת</div>
  </div>
  <div style="display:flex;gap:8px;align-items:center">
    <span id="userBadge" style="font-size:12px;background:rgba(255,255,255,0.2);padding:4px 10px;border-radius:6px"></span>
    <button class="btn btn-success" onclick="openAddModal()">+ הוסף ספק</button>
  </div>
</div>

<div id="syncBar" class="sync-bar">
  <span id="syncMsg"></span>
  <button class="btn" onclick="syncFromShared()" style="padding:4px 10px;font-size:12px">רענן</button>
</div>

<div class="stats">
  <div class="stat"><div class="stat-num" id="sTotal">0</div><div class="stat-label">סה"כ</div></div>
  <div class="stat active"><div class="stat-num" id="sActive">0</div><div class="stat-label">פעיל</div></div>
  <div class="stat inactive"><div class="stat-num" id="sInactive">0</div><div class="stat-label">לא פעיל</div></div>
  <div class="stat blocked"><div class="stat-num" id="sBlocked">0</div><div class="stat-label">חסום / חדש</div></div>
  <div class="stat"><div class="stat-num" id="sFiltered">0</div><div class="stat-label">מוצגים</div></div>
</div>

<div class="toolbar">
  <input type="text" id="searchBox" placeholder="🔍 חיפוש לפי שם, מספר, עיר, טלפון..." oninput="applyFilters()">
  <select id="filterStatus" onchange="applyFilters()">
    <option value="">כל הסטטוסים</option>
    <option>פעיל</option>
    <option>לא פעיל</option>
    <option>חדש</option>
    <option>חסום לתשלום</option>
  </select>
  <select id="filterHandler" onchange="applyFilters()">
    <option value="">כל המטפלים</option>
  </select>
  <select id="filterField" onchange="applyFilters()">
    <option value="">כל תחומי העיסוק</option>
  </select>
  <button class="btn btn-primary" onclick="exportCSV()">⬇ ייצא CSV</button>
</div>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th onclick="sortTable(0)" title="מס ספק">מס׳ <span id="sh0"></span></th>
      <th onclick="sortTable(1)">שם ספק <span id="sh1"></span></th>
      <th onclick="sortTable(2)">סטטוס <span id="sh2"></span></th>
      <th onclick="sortTable(3)">טלפון <span id="sh3"></span></th>
      <th onclick="sortTable(4)">אימייל <span id="sh4"></span></th>
      <th onclick="sortTable(5)">עיר <span id="sh5"></span></th>
      <th onclick="sortTable(6)">תחום <span id="sh6"></span></th>
      <th onclick="sortTable(8)">לטיפול <span id="sh8"></span></th>
      <th>פעולות</th>
    </tr>
  </thead>
  <tbody id="tableBody"></tbody>
</table>
<div id="emptyMsg" class="empty" style="display:none">לא נמצאו ספקים התואמים לחיפוש</div>
</div>
<div class="page-info">
  <span id="pageInfo"></span>
  <div class="page-controls" id="pageCtrls"></div>
</div>
</div>

<!-- Edit/Add Modal -->
<div id="modal" class="modal-bg">
  <div class="modal">
    <h2 id="modalTitle">הוסף ספק</h2>
    <input type="hidden" id="editIdx">
    <div class="form-grid">
      <div class="form-row">
        <label>מספר ספק</label>
        <input id="fNum" type="text" placeholder="מספר ספק">
      </div>
      <div class="form-row">
        <label>סטטוס *</label>
        <select id="fStatus">
          <option>פעיל</option>
          <option>לא פעיל</option>
          <option>חדש</option>
          <option>חסום לתשלום</option>
        </select>
      </div>
    </div>
    <div class="form-row">
      <label>שם ספק *</label>
      <input id="fName" type="text" placeholder="שם הספק בעברית">
    </div>
    <div class="form-row">
      <label>שם לועזי</label>
      <input id="fNameEn" type="text" placeholder="שם באנגלית">
    </div>
    <div class="form-grid">
      <div class="form-row">
        <label>טלפון</label>
        <input id="fPhone" type="tel" placeholder="05X-XXXXXXX">
      </div>
      <div class="form-row">
        <label>אימייל</label>
        <input id="fEmail" type="email" placeholder="example@domain.com">
      </div>
    </div>
    <div class="form-grid">
      <div class="form-row">
        <label>עיר</label>
        <input id="fCity" type="text">
      </div>
      <div class="form-row">
        <label>לטיפול</label>
        <input id="fHandler" type="text" list="handlerList">
        <datalist id="handlerList"></datalist>
      </div>
    </div>
    <div class="form-grid">
      <div class="form-row">
        <label>תחום עיסוק</label>
        <input id="fField" type="text" list="fieldList">
        <datalist id="fieldList"></datalist>
      </div>
      <div class="form-row">
        <label>סוג ספק</label>
        <input id="fType" type="text">
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-primary" onclick="saveSupplier()">שמור</button>
      <button class="btn" onclick="closeModal()" style="background:#eee">ביטול</button>
      <button id="deleteBtn" class="btn btn-danger" onclick="deleteSupplier()" style="margin-right:auto;display:none">מחק</button>
    </div>
  </div>
</div>

